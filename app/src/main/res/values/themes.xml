<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- CoTalk 固定浅色主题：QQ 风格、#66CCFF 顶栏、黑色文字。 -->
    <style name="Base.Theme.CoTalkProject" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_ty</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/blue_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorAccent">@color/blue_ty</item>

        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/title_bar_bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.CoTalkProject" parent="Base.Theme.CoTalkProject" />

    <style name="ShapeAppearanceOverlay.CoTalk.Media" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- 导航栏选中时的文字样式 -->
    <style name="NavigationTextActive" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 导航栏未选中时的文字样式 -->
    <style name="NavigationTextInactive" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
