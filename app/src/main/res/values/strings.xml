    <string name="about_title">关于 CoTalk</string>
    <string name="about_description">CoTalk 是一款基于 Android 与 Java 开发的轻量级局域网即时通讯应用，支持多人文字、图片、语音聊天与 AI 智能群聊体验。</string>
    <string name="about_version_format">版本 %1$s</string>
    <string name="about_tech_title">技术栈</string>
    <string name="about_tech_body">客户端：Android Java / XML\n服务端：Java / Swing / Headless\n数据存储：SQLite\n网络通信：TCP Socket (NDJSON)</string>
    <string name="about_identity_title">隐私与安全</string>
    <string name="about_identity_body">您的账号信息完全保存在本机，并经过加密存储。\n连接服务器时，将由服务端分配临时的内部 UUID，界面将全程仅展示您的昵称，保障您的隐私安全。</string>
    <string name="about_ai_title">AI 功能</string>
    <string name="about_ai_body">“大肥鱼”是服务端可选配置的 AI 智能群友，由服务端 AI 接口驱动。\n- 被 @ 时必定回复；\n- 未被 @ 时，将结合上下文智能判断是否参与聊天；\n- 若服务端未启用 AI 功能或未配置 API Key，AI 群友将不会出现在房间中。</string>
    <string name="about_changelog_title">更新日志</string>
    <string name="about_changelog_version_format">版本：%1$s</string>
    <string name="about_changelog_date_format">更新时间：%1$s</string>
    <string name="about_changelog_body">更新内容：\n- 修复了一些已知问题\n- 此次更新兼容 v0.3.1(beta)-v0.3.3(beta) 版本的服务端</string>
    <string name="about_changelog_date">2026-11-11</string>
